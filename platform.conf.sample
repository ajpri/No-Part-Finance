# No Part Finance server configuration
# Rename platform.conf.sample to platform.conf, then restart the server.
# Missing settings use these defaults. Only full-line # comments are supported.
# Startup refreshes this sample and updates an existing platform.conf.
# Configured values and commented settings are kept; new settings use defaults.
# A missing platform.conf is never created automatically.
# For repeated settings, the last active value above Extra data wins.
# Comments are retained; unrecognized entries move to Extra data below.
# SECURITY: This file can contain your SMTP password. Keep it private.
# Linux: restrict permissions (for example chmod 600 platform.conf) so only
# the administrator/application account can read or change it.
# Windows: use Properties > Security to restrict access to those accounts.
# Use a dedicated, revocable SMTP/app password where your provider supports it.
# Never share your real file. CLI packages can include it and private logs;
# handle those ZIP files as private installation copies. Browser ZIPs omit both.


# --- Server listening address ---
# Choose the HTTP port and IPv4 listening address. Restart after changes.

# Use a whole number from 1 through 65535. The port must be available.
serverPort = 5000
# 0.0.0.0 listens on all IPv4 interfaces; 127.0.0.1 or localhost is local only.
# A specific local IPv4 address listens only on that address.
listenAddress = 0.0.0.0

# --- Account usernames ---
# Choose whether usernames must use an email address format.

enforceEmailUsernames = false

# --- Reverse proxy ---
# Identify trusted proxies that forward the visitor's IP and HTTPS status.

# Enter NGINX's internal/source IP as seen by the finance application.
# This is NOT your dynamic public IP or dynamic-DNS hostname.
# A different subnet across a Layer 3 router is fine if routable.
# If source NAT intervenes, use the address the app sees, provided it
# identifies only trusted proxy traffic. Keep that address stable.
# Separate exact IPv4/IPv6 addresses with commas; no hostnames/subnets.
trustedProxyAddresses =

# --- Web registration ---
# Choose whether visitors can create their own user accounts.

allowWebRegistration = false

# --- Account self-service ---
# Allow signed-in users to change their own names and passwords in My Account.

allowAccountSelfService = true

# --- Login sessions ---
# Keep valid logins across server restarts. Default false; restart after changes. Disabling clears saved sessions.

persistLoginOnRestart = false

# --- Password recovery ---
# Optional emailed password-reset links. Requires SMTP and an explicit public HTTPS application origin.

allowWebPasswordRecovery = false
publicApplicationUrl =

# --- PWA features ---
# Opt in to offline Dashboard storage and system push notifications independently. Restart after changes; the manifest remains available.

pwaOfflineEnabled = false
pushNotificationsEnabled = false

# --- Email delivery (SMTP) ---
# Configure the mail server used to send verification codes.

smtpEnabled = false
smtpHost =
# Omit port to use 587 for starttls or 465 for tls (TLS-on-connect).
# smtpPort =
# Use starttls or tls. Encryption and certificate checks are required.
smtpSecurity = starttls
smtpUsername =
smtpPassword =
smtpFromAddress =
smtpFromName =
# Timeout per blocking network operation, not the total email attempt.
smtpTimeoutSeconds = 10

# --- Email verification ---
# Choose whether users must verify their email before account access.

# true requires enforceEmailUsernames and smtpEnabled with valid settings.
requireRegistrationVerification = false

# --- Extra data (ignored) ---
# Entries in this section are preserved but are not applied.
